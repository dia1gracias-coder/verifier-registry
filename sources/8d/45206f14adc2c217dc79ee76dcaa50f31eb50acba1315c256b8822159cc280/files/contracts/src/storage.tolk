import "errors"

// ИДИОМА "Organize a project into several files": документация предписывает
// раскладку errors.tolk + storage.tolk + messages.tolk + MyContract.tolk.
// Раньше хранилище и сообщения лежали вместе в types.tolk.

// ШАГ 3: политика трат вынесена в отдельную ячейку. Раньше всё лежало в
// корневой ячейке и упиралось в 1023 бита — свободно было ~16 бит, то есть
// ни одно новое поле не влезало. Теперь корень 822 бита плюс ссылка, а у
// политики своя ячейка с запасом. Аннотация @overflow1023_policy больше не
// нужна — корень честно помещается.
// A-9: константа живёт ЗДЕСЬ, потому что нужна и контракту, и функции
// availableAt(). Держать её в двух файлах = тот класс ошибки, что уже
// стрелял дважды (#18, резерв при выводе средств).
const MIN_PAYMENT_AMOUNT = ton("0.01")

fun isSmallOrderKey(k: uint256): bool {
    // ПОЛНЫЙ блок-лист: все ВОСЕМЬ точек малого порядка Ed25519, каждая в
    // обоих прочтениях байт и с обоими знаковыми битами — 19 уникальных
    // значений.
    //
    // Как получены: ВЫЧИСЛЕНЫ из уравнения кривой (-x^2+y^2 = 1+d*x^2*y^2,
    // d = -121665/121666 mod p, p = 2^255-19). Точки порядка 8 найдены
    // решением "удвоение даёт точку порядка 4" с последующей проверкой
    // порядка сложением точек. Ни одно число не взято по памяти и не
    // скопировано из чужого списка — прошлый раз я едва не вписал сюда
    // значения X25519, которые к Ed25519 отношения не имеют (R6).
    //
    // Зачем: подпись под ключ малого порядка подделывается кем угодно, а под
    // нейтральный элемент — универсально, для ЛЮБОГО сообщения. Если такой
    // ключ станет действующим, тратить сможет любой человек в мире.
    //
    // ГЛАВНАЯ ЗАЩИТА всё равно не здесь, а в правах: назначить ключ может
    // только владелец кошелька. Этот список — защита в глубину от
    // социальной инженерии ("сервис прислал вам новый ключ").
    return k == 0 || k == 1 || k == 128 ||
    k == 452312848583266388373324160190187140051835877600158453279131187530910662656 ||
    k == 452312848583266388373324160190187140051835877600158453279131187530910662784 ||
    k == 2707385501144840649318225287225658788936804267575313519463743609750303402022 ||
    k == 17598829001174626432760624799725821048721521463415130398946799010204297198597 ||
    k == 17598829001174626432760624799725821048721521463415130398946799010204297198725 ||
    k == 55188659117513257062467267217118295137698188065244968500265048394206261417927 ||
    k == 57896044618658097711785492504343953926634992332820282019728792003956564819948 ||
    k == 57896044618658097711785492504343953926634992332820282019728792003956564819968 ||
    k == 57896044618658097711785492504343953926634992332820282019728792003956564819969 ||
    k == 60603430119802938361103717791569612715571796600395595539192535613706868221990 ||
    k == 90051628961642774000090525325538718283615417405422581481486423622152440513402 ||
    k == 90051628961642774000090525325538718283615417405422581481486423622152440513530 ||
    k == 107198145114234134044477825965074352192285102991237553427154091444825827049343 ||
    k == 107198145114234134044477825965074352192285102991237553427154091444825827049471 ||
    k == 113084703736171354774252759721462249064333180398065250519993840398162826237895 ||
    k == 115792089237316195423570985008687907853269984665640564039457584007913129639916;
}

// A-4. ВАЖНО ПРО АРИФМЕТИКУ (первая версия была неверной).
//
// Чтобы гарантировать "не больше dailyLimit за ЛЮБОЕ окно длиной W",
// суммируемое покрытие обязано быть ВСЕГДА не меньше W. Иначе трата
// успевает состариться раньше срока и лимит обходится.
//
// Первая попытка: 4 корзины по W/4 — покрытие от 3W/4 до W, то есть иногда
// МЕНЬШЕ W. Получилось слабее прежней схемы: платежи, которые отклонялись,
// стали проходить (4 теста поймали это сразу).
//
// Правильно: N+1 корзина по W/N. Покрытие от W до W*(N+1)/N. Любые две
// траты ближе W друг к другу гарантированно попадают в счёт одновременно,
// значит их сумма проверяется против лимита. Это не "1.25х вместо 2х", а
// строгий 1.0х — ценой того, что окно эффективно до 25% длиннее заказанного.
const BUCKET_DIVISOR = 4 // длина корзины = windowSeconds / 4
const BUCKETS = BUCKET_DIVISOR + 1

struct SpendPolicy {
    dailyLimit: coins
    windowSeconds: uint32
    // Начало САМОЙ СВЕЖЕЙ корзины (не всего окна).
    windowStart: uint32?
    // A-4: четыре корзины по windowSeconds/4 вместо двух счётчиков.
    // Прежняя схема (текущее + предыдущее окно) — классический sliding
    // window counter, у которого худший случай 2х ПО ПОСТРОЕНИЮ: потратить
    // лимит в последнюю секунду окна и ещё раз в последнюю секунду
    // следующего. Сумма четырёх корзин всегда покрывает не меньше 3/4 окна,
    // поэтому такой манёвр больше не проходит.
    // b0 — самая свежая, b4 — самая старая.
    b0: coins
    b1: coins
    b2: coins
    b3: coins
    b4: coins
    // ШАГ 3б (#33): потолок на ОДИН платёж. Без него утечка ключа означала
    // вынос всего дневного лимита одной транзакцией за секунду. С потолком
    // это несколько транзакций подряд — видно в истории кошелька и есть
    // шанс успеть отменить.
    maxSinglePayment: coins
}

// Плоский вид для наружу: клиентам не нужно знать про вынесенную ячейку.
// A2: раньше геттер remainingLimit() считал по ЖЁСТКОМУ окну, а сам контракт
// при платеже — по скользящему. На границе окна геттер обещал боту полный
// лимит, а платёж тут же отклонялся. Тот же класс ошибки, что #24: геттер
// уверенно врал. Теперь арифметика одна и та же в обоих местах.
// A-4: сдвиг корзин ко времени nowTs. Меняет структуру на месте, поэтому
// используется и при платеже, и (на копии) в геттере — арифметика одна.
fun SpendPolicy.rollTo(mutate self, nowTs: int): void {
    if (self.windowStart == null) {
        self.windowStart = nowTs;
        self.b0 = 0;
        self.b1 = 0;
        self.b2 = 0;
        self.b3 = 0;
        self.b4 = 0;
        return;
    }
    val bucketLen = self.windowSeconds / BUCKET_DIVISOR;
    if (bucketLen <= 0) {
        return;
    }
    var steps = (nowTs - self.windowStart) / bucketLen;
    if (steps <= 0) {
        return;
    }
    if (steps >= BUCKETS) {
        // Простой дольше всего покрытия — история неактуальна целиком.
        self.b0 = 0;
        self.b1 = 0;
        self.b2 = 0;
        self.b3 = 0;
        self.b4 = 0;
        self.windowStart = nowTs;
        return;
    }
    var i = 0;
    while (i < steps) {
        self.b4 = self.b3;
        self.b3 = self.b2;
        self.b2 = self.b1;
        self.b1 = self.b0;
        self.b0 = 0;
        i += 1;
    }
    self.windowStart = self.windowStart + steps * bucketLen;
}

fun SpendPolicy.availableAt(self, nowTs: int): coins {
    if (self.windowSeconds == 0) {
        return 0 as coins;
    }
    if (self.windowStart == null) {
        return min(self.dailyLimit, self.maxSinglePayment) as coins;
    }
    // Считаем на КОПИИ — геттер не должен ничего менять, но арифметика
    // обязана совпадать с платёжной до последнего нанотона (урок A2).
    var probe = self;
    probe.rollTo(nowTs);
    val used = probe.b0 + probe.b1 + probe.b2 + probe.b3 + probe.b4;
    val left = used >= self.dailyLimit ? 0 as coins : self.dailyLimit - used;
    val capped = min(left, self.maxSinglePayment) as coins;
    // A-9: при остатке ниже минимальной суммы платежа контракт откажет
    // (AmountTooSmall), а геттер обещал бы этот остаток. Тот же класс
    // "геттер уверенно врёт", ради которого переделывали #24 и A2.
    return capped < MIN_PAYMENT_AMOUNT ? 0 as coins : capped;
}

// A-6: контракт не валидировал СВОЁ начальное хранилище вообще — его целиком
// задаёт разворачивающий. Можно было получить формально "включённое"
// расширение, неспособное провести ни одного платежа (например,
// maxSinglePayment ниже MIN_PAYMENT_AMOUNT). Тот же класс, что #18: два
// места, разные числа, ни одно не сверяется.
// A-17/A-18: ОДИН источник истины. Раньше список инвариантов был переписан
// руками в четырёх местах с РАЗНЫМ составом: UpdateSpendLimit не знал про
// нижнюю границу maxSinglePayment, а isNotDisabled() проверял
// windowSeconds > 0 вместо >= 3600. Оба расхождения давали контракт, который
// рапортует "работаю" и не может провести ни одного платежа.
// A9: потолок лимита был литералом в двух скриптах и отсутствовал здесь —
// четыре места, три разных состава. Ровно то, что A-17/A-18 объявили изжитым.
const MAX_DAILY_LIMIT = ton("50")

fun SpendPolicy.isConsistent(self): bool {
    // E019 (нашла `acton check`): bucketLen = windowSeconds / BUCKET_DIVISOR,
    // а потом это значение УМНОЖАЕТСЯ обратно при сдвиге windowStart.
    // Деление целочисленное, поэтому при окне, не кратном 4, остаток теряется
    // на каждом сдвиге, и реальное покрытие оказывается КОРОЧЕ заказанного —
    // то есть лимит мягче, чем настроил пользователь.
    //
    // Масштаб посчитан: максимум 3 секунды на корзину, до 15 секунд на всё
    // покрытие при суточном окне. Практически ничтожно — но это единственное
    // место, где заявленное расходится с фактическим, а весь проект был про
    // борьбу ровно с такими расхождениями.
    //
    // Чиним требованием кратности, а не подгонкой арифметики: так остаток
    // не теряется вообще, вместо того чтобы теряться "приемлемо мало".
    return self.windowSeconds % BUCKET_DIVISOR == 0 && self.dailyLimit <= MAX_DAILY_LIMIT &&
    self.windowSeconds >= 3600 &&
    self.windowSeconds <= 7 * 86400 &&
    self.dailyLimit > 0 &&
    self.maxSinglePayment >= MIN_PAYMENT_AMOUNT &&
    self.maxSinglePayment <= self.dailyLimit;
}

fun SpendPolicy.assertConsistent(self) {
    assert (self.isConsistent()) throw Errors.InvalidLimitParams;
}

struct ExtensionInfo {
    walletAddress: address
    admin: address
    publicKey: uint256
    seqno: uint32
    dailyLimit: coins
    windowSeconds: uint32
    windowStart: uint32?
    // A-4: наружу отдаём сумму корзин одним числом — клиенту не нужно знать
    // про внутреннее устройство окна, ему важно "сколько потрачено сейчас".
    spentInWindow: coins
    maxSinglePayment: coins
    globalId: int32
    // Плоский вид разворачивает ячейку ротации — клиенту не нужно знать,
    // что она лежит отдельно.
    pendingPublicKey: uint256
    // A-36: геттер tombstoneReserve() добавили с обоснованием "клиент
    // физически не мог посчитать". Дословно то же про срок заявки: скрипт
    // мог сказать только постфактум "проверь срок (час)", а клиент проверить
    // его не мог никак.
    requestedAt: uint32
    cancelled: bool
    paused: bool
}

// ДВУХШАГОВАЯ СМЕНА КЛЮЧА: раньше ротация была в один шаг, и опечатка в
// новом публичном ключе намертво выключала платежи — подписать больше нечем,
// спасала только отмена от админа. Теперь новый ключ сначала ЗАЯВЛЯЕТСЯ
// (подписью текущего), а вступает в силу только после ПОДТВЕРЖДЕНИЯ подписью
// самого нового ключа: этим доказывается, что его приватная часть реально
// существует. Ноль означает "заявки нет".
struct RotationState {
    pendingPublicKey: uint256
    // A4: ПОЛЕ БОЛЬШЕ НЕ ИСПОЛЬЗУЕТСЯ. Проверка requestedAtSeqno < seqno
    // снята в пятнадцатом раунде (R1) вместе с переносом подтверждения во
    // внутренние сообщения. Комментарий ниже описывал защиту, которой в коде
    // УЖЕ НЕТ — тот самый почерк, из которого в этом проекте четырежды
    // рождались критические дыры: правка в одном файле, комментарий в другом.
    // Поле оставлено, потому что его удаление меняет раскладку хранилища,
    // значит адрес, значит сломает сверку для уже развёрнутых экземпляров.
    // Историческое описание (НЕАКТУАЛЬНО):
    // Предзаряженное хранилище задаёт разворачивающий, и контракт его никак
    // не валидировал: можно было записать чужой pendingPublicKey и сразу
    // после установки подтвердить его своим ключом. Теперь подтверждение
    // требует requestedAtSeqno < seqno, а предзаряженное (0 < 0) не проходит.
    requestedAtSeqno: uint32
    // A-23: заявка была бессрочной. Сценарий: оператор заявил ротацию,
    // подтверждение не дошло, про заявку забыли; через полгода новый ключ
    // утёк из старого бэкапа — и его держатель подтверждает заявку,
    // забирая право подписи. Теперь заявка протухает.
    requestedAt: uint32
    // ВРЕМЕННАЯ ПАУЗА (по чек-листам production-контрактов: "когда случается
    // эксплойт, минуты решают"). Отличие от cancelled: пауза ОБРАТИМА.
    // Типичный сценарий — бот ведёт себя странно, надо остановить и
    // разобраться, не сжигая расширение навсегда: отмена необратима и
    // требует разворачивать и устанавливать заново.
    // Блокирует ТОЛЬКО платежи; админские операции и смена ключа работают,
    // иначе пауза мешала бы устранять саму причину.
    paused: bool
    // A3: раньше отменённое расширение "выключалось" обнулением publicKey, и
    // это опиралось на предположение, что против нулевого ключа не сходится
    // ни одна подпись. Аудит показал: нулевые 32 байта — ВАЛИДНАЯ точка
    // кривой ed25519 малого порядка (порядка 4), и подпись под неё
    // подделывается перебором примерно за 4 попытки, если реализация не
    // проверяет малый порядок явно. Не полагаемся на криптографию там, где
    // достаточно одного бита состояния.
    cancelled: bool
}

struct ExtensionStorage {
    walletAddress: address
    admin: address
    publicKey: uint256
    seqno: uint32
    // ШАГ 3б (#35): идентификатор сети. В сообщение его класть НЕ нужно —
    // адрес контракта это хэш от кода и данных, значит контракт с globalId
    // тестнета и мейннета получит РАЗНЫЕ адреса. А domainTag у нас теперь и
    // есть полный хэш адреса, поэтому кросс-сетевой перенос сообщения
    // отсекается сам собой, без единого лишнего бита в теле.
    globalId: int32
    // Состояние смены ключа — в ОТДЕЛЬНОЙ ячейке. Поле на 256 бит выбило
    // корень за предел 1023 (стало 1110): показательно, что освобождённое
    // рефакторингом место съело первое же новое поле.
    rotation: Cell<RotationState>
    // ИДИОМАТИЧНО (по разделу "Idioms and conventions" документации):
    // типизированная ячейка Cell<T>, а не голая cell. Раньше в это поле можно
    // было положить ЛЮБУЮ ячейку и компилятор бы не заметил.
    policy: Cell<SpendPolicy>
}

fun ExtensionStorage.load(): ExtensionStorage {
    return ExtensionStorage.fromCell(contract.getData());
}

fun ExtensionStorage.save(self) {
    contract.setData(self.toCell());
}
