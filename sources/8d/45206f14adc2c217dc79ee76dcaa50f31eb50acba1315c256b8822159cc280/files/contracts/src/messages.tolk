// Входящие и исходящие сообщения контракта.
import "storage"

// external — оба теперь требуют подписи (seqno + validUntil), само сообщение
// приходит с подписью, дописанной в конец (512 бит), контракт её отрезает
// перед разбором полей — см. SimpleExtension.tolk
struct (0x7e8764ef) CollectPaymentFromWallet {
    queryId: uint64
    amount: coins
    destination: address
    seqno: uint32
    validUntil: uint32
    // ШАГ 2: было uint32 — младшие 32 бита хэша адреса. Аудит (#35) отметил,
    // что 32 бита подбираются офчейн за часы: можно перебирать варианты
    // state-init, пока младшие биты адреса не совпадут с чужой меткой.
    // Теперь полный хэш адреса — подобрать нельзя. Раньше не влезало по
    // битам, после переноса тела в отдельную ячейку места хватает.
    domainTag: uint256
    // ШАГ 2 (#11): комментарий к платежу. Площадки обычно требуют memo, чтобы
    // понять, чей это платёж — без него реальная покупка может не зачесться.
    // Лежит отдельной ячейкой, не занимает биты тела. Когда memo не нужен —
    // пустая ячейка.
    payload: cell
    // АУДИТ #23: раньше платёж всегда уходил non-bounceable — при неверном
    // или неинициализированном адресе получателя деньги терялись навсегда.
    // Для снайпинга, где адрес приходит из ненадёжного источника, это не та
    // сторона компромисса. По умолчанию бот ставит true (деньги вернутся);
    // false оставлен для площадок, которым нужен именно non-bounceable.
    bounceable: bool
}

struct (0x342364ac) WithdrawExtensionBalance {
    // АУДИТ (мелочь): queryId был у остальных сообщений, но не здесь —
    // бот не мог сопоставить ответ с запросом.
    queryId: uint64
    seqno: uint32
    validUntil: uint32
    domainTag: uint256
}

// НОВОЕ: смена ключа подписи без полного разворачивания заново — на случай
// если приватный ключ (тот, что хранит бот) когда-нибудь скомпрометирован.
// Само сообщение подписывается ТЕКУЩИМ ключом — только его владелец может
// назначить новый.
// Шаг 2 из двух: подтверждение — теперь ТОЖЕ внутреннее сообщение от админа,
// несущее подпись НОВОГО ключа внутри.
//
// R1: когда заявка переехала во внутренние сообщения, подтверждение осталось
// внешним и проверяло requestedAtSeqno < seqno. Но внутренние сообщения
// seqno НЕ ДВИГАЮТ — после заявки эти значения равны, и условие ложно
// всегда. Ротация не работала вообще. Проверка писалась под прежнюю модель
// (заявка была внешней и сама двигала счётчик) и при переносе не была
// пересмотрена.
//
// R2: плюс пауза блокировала подтверждение, а снять её без платежа старым
// ключом было нельзя — тупик там, где пауза заводилась ради быстрого
// реагирования.
//
// R3: плюс защита от предзаряженной заявки работала только при seqno == 0 —
// один обычный платёж делал 0 < 1 истиной.
//
// Всё три чинятся одним решением: подтверждение требует участия АДМИНА.
// Подпись нового ключа внутри по-прежнему доказывает, что приватная часть
// существует (защита от опечатки сохранена), но seqno и пауза к этому
// сообщению больше не относятся, а предзарядка бесполезна — заявку всё
// равно должен подтвердить владелец кошелька.
struct (0x4e2d8f61) ConfirmSigningKey {
    queryId: uint64
    newKeySignature: bits512
}

// Шаг 1 из двух: заявка на смену — теперь ВНУТРЕННЕЕ сообщение от АДМИНА.
// Раньше подписывалась текущим ключом, то есть право менять ключ было у
// бота. Это не давало ничего полезного (против компрометации бесполезно —
// заявку подписывает тот же подозреваемый ключ) и открывало атаку через
// ключи малого порядка. Отправитель проверяется сетью, подпись не нужна.
struct (0x9a3b7c1d) RotateSigningKey {
    queryId: uint64
    newPublicKey: uint256
}

// internal
struct (0x283b4c3f) CancelSubscription {
    queryId: uint64
}

// АУДИТ #10: изменить лимит можно ТОЛЬКО внутренним сообщением от админа
// (владельца кошелька), намеренно НЕ подписью. Ключ подписи держит бот —
// если бы менять лимит можно было подписью, бот мог бы сам себе поднять
// разрешённую к трате сумму. Это ровно то, чего допускать нельзя.
// АУДИТ #19: вывод средств был ТОЛЬКО внешним сообщением с подписью. После
// отмены ключ обнуляется — и баланс оказывался заперт навсегда. Теперь есть
// путь вывода, который вообще не зависит от ключа: внутреннее сообщение от
// админа. Заодно это закрывает #12 (потеря приватного ключа).
struct (0x7c4a1b83) WithdrawToAdmin {
    queryId: uint64
}

// Временная остановка платежей. Только от админа, обратима.
struct (0x2b7f4e19) SetPaused {
    queryId: uint64
    paused: bool
}

struct (0x5f1e9d2a) UpdateSpendLimit {
    queryId: uint64
    newDailyLimit: coins
    newWindowSeconds: uint32
    newMaxSinglePayment: coins
}

struct (0x43c7641f) TopUp {}

// ИДИОМА "Emit events and logs": события наружу через внешние сообщения на
// адрес none. Индексаторы их ловят и строят картину активности. Для
// контракта, который АВТОМАТИЧЕСКИ тратит чужие деньги, след наружу важен:
// иначе ни бот, ни пользователь не отследят платежи иначе как разбором
// транзакций вручную.
// ПО РУКОВОДСТВУ ПО БЕЗОПАСНОСТИ, раздел "Return gas excesses carefully":
// если излишки не возвращать, средства понемногу накапливаются в контракте.
// Опкод 0xd53276db — тот же, что используют жетоны, он общепринятый.
struct (0xd53276db) Excesses {}

// События на АДМИНСКИЕ действия. Раньше наружу выходили только платежи, и
// отмена, смена лимита или ротация ключа были не видны индексаторам вообще —
// то есть по цепочке нельзя было понять, что с расширением происходило.
// action: 1 = отмена, 2 = смена лимита, 3 = заявка на смену ключа,
//         4 = подтверждение ключа, 5 = пауза, 6 = снятие паузы
// Опкод нужен не только входящим: поиск события по типу (в тестах и у
// индексаторов) опирается на префикс сериализации.
struct (0x8a1c40d2) AdminActionEvent {
    queryId: uint64
    action: uint8
}

struct (0x8a1c40d1) PaymentRequestedEvent {
    queryId: uint64
    amount: coins
    destination: address
    spentInWindowAfter: coins
}
