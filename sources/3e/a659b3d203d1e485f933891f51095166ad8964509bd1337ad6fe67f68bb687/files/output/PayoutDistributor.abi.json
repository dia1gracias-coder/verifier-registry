        }
      ],
      "description": "owner is the cold multisig; guardian is an online key that may pause but\nnever unpause and never move funds."
    },
    {
      "kind": "struct",
      "name": "Routing",
      "ty_idx": 36,
      "fields": [
        {
          "name": "gasWallet",
          "ty_idx": 7
        },
        {
          "name": "excessTo",
          "ty_idx": 7
        },
        {
          "name": "jettonWallet",
          "ty_idx": 37
        }
      ],
      "description": "gasWallet is the only sender allowed to submit a batch. excessTo receives\nTEP-74 excesses — pointing it at the gas wallet returns leftover TON to the\naccount that paid it and keeps N receipts off the fund-holding contract."
    },
    {
      "kind": "struct",
      "name": "Limits",
      "ty_idx": 39,
      "fields": [
