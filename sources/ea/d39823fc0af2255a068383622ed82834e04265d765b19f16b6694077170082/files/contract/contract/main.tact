import "@stdlib/deploy";

// ================================= MESSAGES =================================

message TransferJettons {
    queryId: Int as uint64;
        destination: Address;
            amount: Int as coins;
                responseAddress: Address;
                }

                message Withdraw {
                    queryId: Int as uint64;
                    }

                    // ================================= CONTRACT =================================

                    contract JettonSeller with Deployable {

                        // --- Contract Storage ---
                            owner: Address;
                                jettonWallet: Address;
                                    price: Int as coins;
                                        jettonAmount: Int as coins;

                                            init(owner: Address, jettonWallet: Address, price: Int, jettonAmount: Int) {
                                                    self.owner = owner;
                                                            self.jettonWallet = jettonWallet;
                                                                    self.price = price;
                                                                            self.jettonAmount = jettonAmount;
                                                                                }

                                                                                    // --- Receive Handlers ---

                                                                                        // Main entry point for users buying jettons
                                                                                            receive() {
                                                                                                    let sender: Address = context().sender;
                                                                                                            let sentValue: Int = context().value;

                                                                                                                    let requiredValue: Int = self.price + 200000000; // self.price + 0.2 TON
                                                                                                                            require(sentValue >= requiredValue, "Error: Not enough TON sent.");

                                                                                                                                    // <<<<<<<<<<<<<<<< تغییر اصلی اینجاست >>>>>>>>>>>>>>>>
                                                                                                                                            // Send a message to ourselves to trigger the jetton transfer logic
                                                                                                                                                    // NOTE: Using myAddress() instead of self.address for old compilers
                                                                                                                                                            send(SendParameters{
                                                                                                                                                                        to: myAddress(),
                                                                                                                                                                                    value: 100000000, // 0.1 TON
                                                                                                                                                                                                body: TransferJettons{
                                                                                                                                                                                                                queryId: 0, 
                                                                                                                                                                                                                                destination: sender, 
                                                                                                                                                                                                                                                amount: self.jettonAmount,
                                                                                                                                                                                                                                                                responseAddress: self.owner
                                                                                                                                                                                                                                                                            }.toCell()
                                                                                                                                                                                                                                                                                    });
                                                                                                                                                                                                                                                                                            // <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

                                                                                                                                                                                                                                                                                                    // Return excess TON to the buyer
                                                                                                                                                                                                                                                                                                            let change: Int = sentValue - requiredValue;
                                                                                                                                                                                                                                                                                                                    if (change > 0) {
                                                                                                                                                                                                                                                                                                                                send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                to: sender,
                                                                                                                                                                                                                                                                                                                                                                value: change,
                                                                                                                                                                                                                                                                                                                                                                                bounce: false
                                                                                                                                                                                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                            // Internal message to handle the jetton transfer
                                                                                                                                                                                                                                                                                                                                                                                                                receive(msg: TransferJettons) {
                                                                                                                                                                                                                                                                                                                                                                                                                        let jettonTransferBody: Cell = beginCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeUint(0xf8a7ea5, 32)
                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeUint(msg.queryId, 64)
                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeCoins(msg.amount)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeAddress(msg.destination)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeAddress(msg.responseAddress)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeMaybeRef(null)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeCoins(50000000) // 0.05 TON
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeMaybeRef(null)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .endCell();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                to: self.jettonWallet,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            value: 100000000, // 0.1 TON
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        bounce: true,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    body: jettonTransferBody
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    // Message from the owner to withdraw profits
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        receive(msg: Withdraw) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                require(context().sender == self.owner, "Error: Only owner can withdraw.");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            to: self.owner,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        value: 0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    bounce: false,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                mode: 128 // Send all remaining balance
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                // --- Get Methods (Compatible with ALL Tact versions) ---
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    get fun price(): Int {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return self.price;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    get fun jetton_amount(): Int {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return self.jettonAmount;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    get fun owner(): Address {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return self.owner;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    get fun jetton_wallet(): Address {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return self.jettonWallet;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }