import "@stdlib/deploy";

contract JettonSeller with Deployable {
        owner: Address;
            jettonMaster: Address;
                price: Int as coins;        // قیمت به نانوTON (0.1 TON = 100000000)
                    jettonAmount: Int as coins; // مقدار Jetton به کاربر (2000 = 2000000000)

                        init(owner: Address, jettonMaster: Address, price: Int, jettonAmount: Int) {
                                self.owner = owner;
                                        self.jettonMaster = jettonMaster;
                                                self.price = price;
                                                        self.jettonAmount = jettonAmount;
                                                            }

                                                                receive() {
                                                                        let sender = context().sender;
                                                                                let receivedAmount = context().value;

                                                                                        // بررسی اینکه پرداخت کاربر کافی است
                                                                                                if (receivedAmount >= self.price) {
                                                                                                            
                                                                                                                        // بازگشت مبلغ اضافی به کاربر
                                                                                                                                    let change = receivedAmount - self.price;
                                                                                                                                                if (change > 0) {
                                                                                                                                                                send(SendParameters{
                                                                                                                                                                                    to: sender,
                                                                                                                                                                                                        value: change,
                                                                                                                                                                                                                            mode: 64
                                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                    // ارسال TON به مالک (کسر هزینه گس)
                                                                                                                                                                                                                                                                                let ownerAmount = self.price - ton("0.03");
                                                                                                                                                                                                                                                                                            if (ownerAmount > 0) {
                                                                                                                                                                                                                                                                                                            send(SendParameters{
                                                                                                                                                                                                                                                                                                                                to: self.owner,
                                                                                                                                                                                                                                                                                                                                                    value: ownerAmount,
                                                                                                                                                                                                                                                                                                                                                                        mode: 64
                                                                                                                                                                                                                                                                                                                                                                                        });
                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                // درخواست Mint Jetton برای کاربر
                                                                                                                                                                                                                                                                                                                                                                                                                            send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                                            to: self.jettonMaster,
                                                                                                                                                                                                                                                                                                                                                                                                                                                            value: ton("0.1"), // هزینه گس برای mint
                                                                                                                                                                                                                                                                                                                                                                                                                                                                            body: beginCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeUint(0x178d4519, 32) // OP Code: mint
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeUint(0, 64) // query_id
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeCoins(self.jettonAmount) // مقدار Jetton
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeAddress(sender) // گیرنده (کاربر)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeAddress(self.owner) // پاسخ‌دهنده
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeCoins(ton("0.01")) // TON برای گیرنده
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeUint(0, 1) // forward_payload
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .endCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        });

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                } else {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            // اگر پرداخت ناکافی بود، بازگشت کامل مبلغ
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        to: sender,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        value: receivedAmount,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        mode: 64
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    // تابع برای تغییر قیمت (فقط مالک)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        fun setPrice(newPrice: Int) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                require(context().sender == self.owner, "Only owner can change price");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        self.price = newPrice;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                // تابع برای تغییر مقدار Jetton (فقط مالک)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    fun setJettonAmount(newAmount: Int) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            require(context().sender == self.owner, "Only owner can change jetton amount");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    self.jettonAmount = newAmount;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
