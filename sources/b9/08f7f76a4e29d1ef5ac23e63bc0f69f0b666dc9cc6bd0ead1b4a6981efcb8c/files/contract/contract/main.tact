import "@stdlib/deploy";

message Withdraw {
    queryId: Int as uint64;
    }

    message SetJettonWallet {
        jettonWallet: Address;
        }

        message DynamicPayment {
            tagId: String;
                jettonAmount: Int as uint64;
                    tonAmount: Int as uint64;
                    }

                    contract Cashback {
                        owner: Address;
                            jettonWallet: Address?;

                                init(owner: Address) {
                                        self.owner = owner;
                                                self.jettonWallet = null;
                                                    }

                                                        receive(msg: DynamicPayment) {
                                                                let sender: Address = context().sender;
                                                                        let incoming: Int = context().value;

                                                                                require(incoming >= msg.tonAmount * 1_000_000_000, "Not enough TON sent");
                                                                                        require(self.jettonWallet != null, "Jetton wallet not set");

                                                                                                let customMessage: Cell = beginCell()
                                                                                                            .storeUint(0, 32)
                                                                                                                        .storeSlice(
                                                                                                                                        beginString()
                                                                                                                                                            .concat("from me - ")
                                                                                                                                                                                .concat(msg.tagId)
                                                                                                                                                                                                    .toString()
                                                                                                                                                                                                                        .asSlice()
                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                .endCell();

                                                                                                                                                                                                                                                        let transferBody: Cell = beginCell()
                                                                                                                                                                                                                                                                    .storeUint(0xf8a7ea5, 32)
                                                                                                                                                                                                                                                                                .storeUint(0, 64)
                                                                                                                                                                                                                                                                                            .storeCoins(msg.jettonAmount)
                                                                                                                                                                                                                                                                                                        .storeAddress(sender)
                                                                                                                                                                                                                                                                                                                    .storeAddress(self.owner)
                                                                                                                                                                                                                                                                                                                                .storeUint(0, 1)
                                                                                                                                                                                                                                                                                                                                            .storeCoins(1)
                                                                                                                                                                                                                                                                                                                                                        .storeUint(1, 1)
                                                                                                                                                                                                                                                                                                                                                                    .storeRef(customMessage)
                                                                                                                                                                                                                                                                                                                                                                                .endCell();

                                                                                                                                                                                                                                                                                                                                                                                        send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                    to: self.jettonWallet!!,
                                                                                                                                                                                                                                                                                                                                                                                                                value: 50_000_000,
                                                                                                                                                                                                                                                                                                                                                                                                                            bounce: true,
                                                                                                                                                                                                                                                                                                                                                                                                                                        mode: 64,
                                                                                                                                                                                                                                                                                                                                                                                                                                                    body: transferBody
                                                                                                                                                                                                                                                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                    receive() {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let incoming: Int = context().value;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    let sender: Address = context().sender;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            require(incoming == 1_000_000_000, "Send exactly 1 TON");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    require(self.jettonWallet != null, "Jetton wallet not set");

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            let customMessage: Cell = beginCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeUint(0, 32)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeSlice("from me".asSlice())
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .endCell();

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        let transferBody: Cell = beginCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeUint(0xf8a7ea5, 32)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeUint(0, 64)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeCoins(1000)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeAddress(sender)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeAddress(self.owner)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeUint(0, 1)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeCoins(1)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeUint(1, 1)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeRef(customMessage)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .endCell();

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    to: self.jettonWallet!!,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                value: 50_000_000,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            bounce: true,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        mode: 64,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    body: transferBody
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    receive(msg: SetJettonWallet) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            require(context().sender == self.owner, "Only owner can set jetton wallet");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    require(self.jettonWallet == null, "Jetton wallet already set");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            self.jettonWallet = msg.jettonWallet;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    receive(msg: Withdraw) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            require(context().sender == self.owner, "Only owner can withdraw");

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                to: self.owner,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            value: 0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        bounce: false,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    mode: 128
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    get fun getOwner(): Address {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return self.owner;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    get fun getJettonWallet(): Address? {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return self.jettonWallet;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    get fun isJettonWalletSet(): Bool {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return self.jettonWallet != null;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }