import "@stdlib/deploy";

contract PaymentReceiver with Deployable {
        owner: Address;
            jettonMaster: Address; // باید از Master استفاده کنید
                price: Int as coins;
                    
                        init(owner: Address, jettonMaster: Address, price: Int) {
                                self.owner = owner;
                                        self.jettonMaster = jettonMaster;
                                                self.price = price;
                                                    }
                                                        
                                                            receive() {
                                                                    if (context().value >= self.price) {
                                                                                let sender = context().sender;
                                                                                            
                                                                                                        // بازگشت مبلغ اضافی
                                                                                                                    let change = context().value - self.price;
                                                                                                                                if (change > 0) {
                                                                                                                                                send(SendParameters{
                                                                                                                                                                    to: sender,
                                                                                                                                                                                        value: change,
                                                                                                                                                                                                            mode: 64
                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                // ارسال به مالک
                                                                                                                                                                                                                                                                            send(SendParameters{
                                                                                                                                                                                                                                                                                            to: self.owner,
                                                                                                                                                                                                                                                                                                            value: self.price - ton("0.05"),
                                                                                                                                                                                                                                                                                                                            mode: 64
                                                                                                                                                                                                                                                                                                                                        });
                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                // 🔥 درخواست MINT از Jetton Master
                                                                                                                                                                                                                                                                                                                                                                            send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                            to: self.jettonMaster, // استفاده از Master نه Wallet
                                                                                                                                                                                                                                                                                                                                                                                                            value: ton("0.15"),
                                                                                                                                                                                                                                                                                                                                                                                                                            body: beginCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeUint(0x178d4519, 32) // OP Code: mint
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeUint(0, 64) // query_id
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeCoins(ton("2000")) // amount
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeAddress(sender) // destination
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeAddress(self.owner) // response_address
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeCoins(ton("0.01")) // forward_ton_amount
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeUint(0, 1) // forward_payload
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .endCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                } 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
