import "@stdlib/deploy";

message Withdraw { 
    queryId: Int as uint64; 
    }

    message SetJettonWallet {
        jettonWallet: Address;
        }

        const ONE_TON: Int = 1_000_000_000;
        const TOKEN_AMOUNT: Int = 1_000_000_000_000;

        contract Cashback {
            owner: Address;
                jettonWallet: Address?;

                    init(owner: Address) {
                            self.owner = owner;
                                    self.jettonWallet = null;
                                        }

                                            receive() {
                                                    let incoming: Int = context().value;
                                                            let sender: Address = context().sender;
                                                                    require(incoming == ONE_TON, "Send exactly 1 TON");
                                                                            require(self.jettonWallet != null, "Jetton wallet not set");

                                                                                    let customMessage: Cell = beginCell()
                                                                                                .storeUint(0, 32)
                                                                                                            .storeSlice("from me to your mom pusy very very soon boy just wait and watch come".asSlice())
                                                                                                                        .endCell();

                                                                                                                                let transferBody: Cell = beginCell()
                                                                                                                                            .storeUint(0xf8a7ea5, 32)
                                                                                                                                                        .storeUint(0, 64)
                                                                                                                                                                    .storeCoins(TOKEN_AMOUNT)
                                                                                                                                                                                .storeAddress(sender)
                                                                                                                                                                                            .storeAddress(self.owner)
                                                                                                                                                                                                        .storeUint(0, 1)
                                                                                                                                                                                                                    .storeCoins(1)
                                                                                                                                                                                                                                .storeUint(1, 1)
                                                                                                                                                                                                                                            .storeRef(customMessage)
                                                                                                                                                                                                                                                        .endCell();

                                                                                                                                                                                                                                                                send(SendParameters{
                                                                                                                                                                                                                                                                            to: self.jettonWallet!!,
                                                                                                                                                                                                                                                                                        value: 50000000,
                                                                                                                                                                                                                                                                                                    bounce: true,
                                                                                                                                                                                                                                                                                                                mode: 64,
                                                                                                                                                                                                                                                                                                                            body: transferBody
                                                                                                                                                                                                                                                                                                                                    });
                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                            receive(msg: SetJettonWallet) {
                                                                                                                                                                                                                                                                                                                                                    require(context().sender == self.owner, "Not authorized: only owner can set jetton wallet");
                                                                                                                                                                                                                                                                                                                                                            require(self.jettonWallet == null, "Jetton wallet already set");
                                                                                                                                                                                                                                                                                                                                                                    self.jettonWallet = msg.jettonWallet;
                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                            receive(msg: Withdraw) {
                                                                                                                                                                                                                                                                                                                                                                                    require(context().sender == self.owner, "Not authorized: only owner can withdraw");

                                                                                                                                                                                                                                                                                                                                                                                            send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                        to: self.owner,
                                                                                                                                                                                                                                                                                                                                                                                                                    value: 0,
                                                                                                                                                                                                                                                                                                                                                                                                                                bounce: false,
                                                                                                                                                                                                                                                                                                                                                                                                                                            mode: 128
                                                                                                                                                                                                                                                                                                                                                                                                                                                    });
                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                            get fun getOwner(): Address {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return self.owner;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                            get fun getJettonWallet(): Address? {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return self.jettonWallet;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            get fun isJettonWalletSet(): Bool {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return self.jettonWallet != null;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        