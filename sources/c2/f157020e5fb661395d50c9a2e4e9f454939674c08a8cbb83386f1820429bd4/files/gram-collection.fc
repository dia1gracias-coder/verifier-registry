;; Gram DNS collection — reconstruction draft v1

;; storage#_ collection_content:^Cell nft_item_code:^Cell
;;           jetton_wallet:MsgAddress admin:MsgAddress config:^Cell = Storage;

() save_data(cell content, cell nft_item_code, slice jetton_wallet, slice jetton_master, cell jetton_wallet_code) impure inline {
    set_data(begin_cell()
            .store_ref(content)
            .store_ref(nft_item_code)
            .store_slice(jetton_wallet)
            .store_slice(jetton_master)
            .store_ref(jetton_wallet_code)
            .end_cell());
}

(cell, cell, slice, slice, cell) load_data() inline {
    var ds = get_data().begin_parse();
    return (ds~load_ref(), ds~load_ref(), ds~load_msg_addr(), ds~load_msg_addr(), ds~load_ref());
}

forall X -> tuple to_tuple(X x) asm "NOP";
(builder, tuple) untuple_state(tuple t) asm "UNPAIR";

tuple snake_begin() inline {
    return to_tuple(pair(begin_cell().store_uint(0, 8), null()));
}

tuple snake_store(tuple state, slice data) inline {
    var (builder b, tuple prev) = untuple_state(state);
    int free = 1016 - b.builder_bits();
    if (free >= data.slice_bits()) {
        return to_tuple(pair(b.store_slice(data), prev));
    }
    if (free > 0) {
        prev = to_tuple(pair(b.store_slice(data~load_bits(free)), prev));
    }
    return to_tuple(pair(begin_cell().store_slice(data), prev));
}

cell snake_end(tuple state) inline {
    var (builder b, tuple prev) = untuple_state(state);
    cell result = b.end_cell();
    while (~ null?(prev)) {
        var (builder pb, tuple pprev) = untuple_state(prev);
        result = pb.store_ref(result).end_cell();
        prev = pprev;
    }
    return result;
}

cell calculate_nft_item_state_init(int item_index, cell nft_item_code) {
    cell data = begin_cell().store_uint(item_index, 256).store_slice(my_address()).end_cell();
    return begin_cell().store_uint(0, 2).store_dict(nft_item_code).store_dict(data).store_uint(0, 1).end_cell();
}

slice calculate_nft_item_address(int wc, cell state_init) {
    return begin_cell()
            .store_uint(4, 3)
            .store_int(wc, 8)
            .store_uint(cell_hash(state_init), 256)
            .end_cell()
            .begin_parse();
}

() deploy_nft_item(int item_index, cell nft_item_code, cell nft_content, cell state_init, slice nft_address) impure {
    var msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(nft_address)
            .store_coins(0)
            .store_uint(4 + 2 + 1, 108)
            .store_ref(state_init)
            .store_ref(nft_content);
    send_raw_message(msg.end_cell(), 64);
}

cell build_content(cell metadata, slice domain) {
    var st = snake_begin();
    st = snake_store(st, domain);
    st = snake_store(st, ".gram");
    metadata~udict_set_ref(256, "name"H, snake_end(st));

    st = snake_begin();
    st = snake_store(st, "https://dns-cdn.gramcoin.org/dnsimage/");
    st = snake_store(st, domain);
    st = snake_store(st, ".png");
    metadata~udict_set_ref(256, "image"H, snake_end(st));

    st = snake_begin();
    st = snake_store(st, "A .gram blockchain domain. ");
    st = snake_store(st, "Gram DNS is a service that allows users to assign a human-readable name to crypto wallets, smart contracts, and websites.");
    metadata~udict_set_ref(256, "description"H, snake_end(st));

    return begin_cell().store_uint(0, 8).store_dict(metadata).end_cell();
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        throw(0xffff);
    }
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        return ();
    }
    slice sender_address = cs~load_msg_addr();
    int op = in_msg_body~load_uint(32);
    var (content, nft_item_code, jetton_wallet, admin, config) = load_data();

    if (op == op::transfer_notification) {
        int query_id = in_msg_body~load_uint(64);
        int jetton_amount = in_msg_body~load_coins();
        slice from_address = in_msg_body~load_msg_addr();
        int is_ref = in_msg_body~load_int(1);
        if (is_ref) {
            in_msg_body = in_msg_body~load_ref().begin_parse();
        }
        int fwd_op = slice_bits(in_msg_body) > 31 ? in_msg_body~load_uint(32) : 0;
        if (fwd_op == op::fill_up) {
            return ();
        }
        int now_time = now();
        slice domain = read_domain_from_comment(in_msg_body);
        int len = slice_bits(domain);
        int min_price = get_min_price(len, now_time);
        int valid = (now_time > auction_start_time)
                & (len > 0)
                & (len <= 256)
                & (mod(len, 8) == 0)
                & check_domain_string(domain)
                & (jetton_amount >= min_price)
                & equal_slices(jetton_wallet, sender_address)
                & msg_value >= min_deploy_value;
        ifnot (valid) {
            cell refund_body = begin_cell()
                    .store_uint(op::jetton_transfer, 32)
                    .store_uint(query_id, 64)
                    .store_coins(jetton_amount)
                    .store_slice(from_address)
                    .store_slice(from_address)
                    .store_uint(0, 6)
                    .end_cell();
            send_raw_message(begin_cell()
                    .store_uint(0x18, 6)
                    .store_slice(sender_address)
                    .store_coins(0)
                    .store_uint(1, 107)
                    .store_ref(refund_body)
                    .end_cell(), 64);
            return ();
        }
        int item_index = slice_hash(domain);
        cell state_init = calculate_nft_item_state_init(item_index, nft_item_code);
        slice nft_address = calculate_nft_item_address(workchain(), state_init);
        cell domain_cell = begin_cell().store_slice(domain).end_cell();
        cell nft_content = begin_cell()
                .store_slice(from_address)
                .store_ref(domain_cell)
                .store_coins(jetton_amount)
                .store_slice(calculate_jetton_wallet_address(calculate_jetton_wallet_state_init(nft_address, admin, config)))
                .end_cell();
        deploy_nft_item(item_index, nft_item_code, nft_content, state_init, nft_address);
        return ();
    }

    if (op == op::dns_bid_payout) {
        int query_id = in_msg_body~load_uint(64);
        slice to_address = in_msg_body~load_msg_addr();
        int item_index = in_msg_body~load_uint(256);
        int amount = in_msg_body~load_coins();
        cell state_init = calculate_nft_item_state_init(item_index, nft_item_code);
        slice item_address = calculate_nft_item_address(workchain(), state_init);
        throw_unless(420, equal_slices(item_address, sender_address));
        cell transfer_body = begin_cell()
                .store_uint(op::jetton_transfer, 32)
                .store_uint(query_id, 64)
                .store_coins(amount)
                .store_slice(item_address)
                .store_slice(to_address)
                .store_uint(0, 6)
                .end_cell();
        send_raw_message(begin_cell()
                .store_uint(0x18, 6)
                .store_slice(jetton_wallet)
                .store_coins(0)
                .store_uint(1, 107)
                .store_ref(transfer_body)
                .end_cell(), 64);
        return ();
    }

    if (op == op::dns_bid_refund) {
        int query_id = in_msg_body~load_uint(64);
        slice to_address = in_msg_body~load_msg_addr();
        int item_index = in_msg_body~load_uint(256);
        int amount = in_msg_body~load_coins();
        cell state_init = calculate_nft_item_state_init(item_index, nft_item_code);
        throw_unless(420, equal_slices(calculate_nft_item_address(workchain(), state_init), sender_address));
        cell transfer_body = begin_cell()
                .store_uint(op::jetton_transfer, 32)
                .store_uint(query_id, 64)
                .store_coins(amount)
                .store_slice(to_address)
                .store_slice(to_address)
                .store_uint(0, 6)
                .end_cell();
        send_raw_message(begin_cell()
                .store_uint(0x18, 6)
                .store_slice(jetton_wallet)
                .store_coins(0)
                .store_uint(1, 107)
                .store_ref(transfer_body)
                .end_cell(), 64);
        return ();
    }

    if (op == op::fill_up) {
        return ();
    }

    if (op == op::admin_update) {
        throw_unless(419, jetton_wallet.preload_uint(2) == 0);
        save_data(content, nft_item_code, in_msg_body, admin, config);
        return ();
    }

    throw(0xffff);
}

;; Get methods

(int, cell, slice) get_collection_data() method_id {
    var (content, nft_item_code, jetton_wallet, admin, config) = load_data();
    return (-1, content, zero_address());
}

slice get_nft_address_by_index(int index) method_id {
    var (content, nft_item_code, jetton_wallet, admin, config) = load_data();
    cell state_init = calculate_nft_item_state_init(index, nft_item_code);
    return calculate_nft_item_address(workchain(), state_init);
}


cell get_nft_content(int index, cell individual_nft_content) method_id {
    slice cs = individual_nft_content.begin_parse();
    cell extra_cell = cs~load_ref();
    slice domain = cs.preload_ref().begin_parse();
    slice extra = extra_cell.begin_parse();
    try {
        throw_unless(412, extra~load_uint(8) == 0);
        cell metadata = extra~load_dict();
        return build_content(metadata, domain);
    } catch (_, _) {
        return build_content(null(), domain);
    }
}

int get_domain_price(int domain_bits_length) method_id(121399) {
    return get_min_price(domain_bits_length, now());
}

(int, cell) dnsresolve(slice subdomain, int category) method_id {
    throw_unless(70, mod(slice_bits(subdomain), 8) == 0);
    int starts_with_zero_byte = subdomain.preload_int(8) == 0;
    if (starts_with_zero_byte & (slice_bits(subdomain) == 8)) {
        return (8, null());
    }
    if (starts_with_zero_byte) {
        subdomain~load_uint(8);
    }
    int top_subdomain_bits = get_top_domain_bits(subdomain);
    slice top_subdomain = subdomain~load_bits(top_subdomain_bits);
    int item_index = slice_hash(top_subdomain);
    cell result = begin_cell()
            .store_uint(dns_next_resolver_prefix, 16)
            .store_slice(get_nft_address_by_index(item_index))
            .end_cell();
    return (top_subdomain_bits + (starts_with_zero_byte ? 8 : 0), result);
}
