import "@stdlib/deploy";

message Withdraw { 
        queryId: Int as uint64; 
        }

        message SetJettonWallet {
            jettonWallet: Address;
            }

            const ONE_TON: Int = 1_000_000_000;
            const TOKEN_AMOUNT: Int = 1000;

            contract Cashback {
                owner: Address;
                    jettonWallet: Address?; // تغییر به optional
                        
                            init(owner: Address) {
                                    self.owner = owner;
                                            self.jettonWallet = null; // مقدار اولیه null
                                                }
                                                    
                                                        receive() {
                                                                let incoming: Int = context().value;
                                                                        let sender: Address = context().sender;
                                                                                require(incoming == ONE_TON, "Send exactly 1 TON");
                                                                                        
                                                                                                // بررسی اینکه jettonWallet تنظیم شده باشد
                                                                                                        require(self.jettonWallet != null, "Jetton wallet not set");
                                                                                                                
                                                                                                                        // ساخت پیام برای انتقال Jetton
                                                                                                                                let transferBody: Cell = beginCell()
                                                                                                                                            .storeUint(0xf8a7ea5, 32) // opcode برای transfer در Jetton
                                                                                                                                                        .storeUint(0, 64) // query_id
                                                                                                                                                                    .storeCoins(TOKEN_AMOUNT) // مقدار Jetton
                                                                                                                                                                                .storeAddress(sender) // آدرس گیرنده
                                                                                                                                                                                            .storeAddress(self.owner) // آدرس پاسخ‌دهنده
                                                                                                                                                                                                        .storeUint(0, 1) // custom_payload (empty)
                                                                                                                                                                                                                    .storeCoins(0) // forward_ton_amount
                                                                                                                                                                                                                                .storeUint(0, 1) // forward_payload (empty)
                                                                                                                                                                                                                                            .endCell();
                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                            // ارسال پیام به قرارداد Jetton برای انتقال به کاربر
                                                                                                                                                                                                                                                                    send(SendParameters{
                                                                                                                                                                                                                                                                                to: self.jettonWallet!!,
                                                                                                                                                                                                                                                                                            value: 30000000, // حدود 0.03 TON برای کارمزد انتقال Jetton
                                                                                                                                                                                                                                                                                                        bounce: true,
                                                                                                                                                                                                                                                                                                                    mode: 64, // حامل تمام هزینه‌های گس
                                                                                                                                                                                                                                                                                                                                body: transferBody
                                                                                                                                                                                                                                                                                                                                        });
                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                    receive(msg: SetJettonWallet) {
                                                                                                                                                                                                                                                                                                                                                            require(context().sender == self.owner, "Not authorized: only owner can set jetton wallet");
                                                                                                                                                                                                                                                                                                                                                                    require(self.jettonWallet == null, "Jetton wallet already set");
                                                                                                                                                                                                                                                                                                                                                                            self.jettonWallet = msg.jettonWallet;
                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                        receive(msg: Withdraw) {
                                                                                                                                                                                                                                                                                                                                                                                                require(context().sender == self.owner, "Not authorized: only owner can withdraw");
                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                            to: self.owner,
                                                                                                                                                                                                                                                                                                                                                                                                                                        value: 0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                    bounce: false,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                mode: 128 // SendAllRemaining
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    get fun getOwner(): Address {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return self.owner;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        get fun getJettonWallet(): Address? {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                return self.jettonWallet;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            get fun isJettonWalletSet(): Bool {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return self.jettonWallet != null;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
