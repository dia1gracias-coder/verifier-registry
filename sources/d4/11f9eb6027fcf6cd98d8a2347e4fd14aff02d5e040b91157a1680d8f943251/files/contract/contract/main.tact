import "@stdlib/deploy";

contract PaymentReceiver with Deployable {
    owner: Address;
        jettonWallet: Address;
            jettonMaster: Address;
                price: Int as coins; // قیمت به واحد TON
                    
                        init(owner: Address, jettonMaster: Address, jettonWallet: Address, price: Int) {
                                self.owner = owner;
                                        self.jettonMaster = jettonMaster;
                                                self.jettonWallet = jettonWallet;
                                                        self.price = price;
                                                            }
                                                                
                                                                    // دریافت پرداخت و ارسال Jetton
                                                                        receive() {
                                                                                // فقط پرداخت‌های معتبر را پردازش می‌کند
                                                                                        if (context().value >= self.price) {
                                                                                                    let sender = context().sender;
                                                                                                                
                                                                                                                            // ارسال TON اضافی به فرستنده (در صورت پرداخت بیش از قیمت)
                                                                                                                                        let change = context().value - self.price;
                                                                                                                                                    if (change > 0) {
                                                                                                                                                                    send(SendParameters{
                                                                                                                                                                                        to: sender,
                                                                                                                                                                                                            value: change,
                                                                                                                                                                                                                                mode: 64
                                                                                                                                                                                                                                                });
                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                    // ارسال TON به مالک (کسر هزینه گس)
                                                                                                                                                                                                                                                                                                let ownerAmount = self.price - ton("0.05");
                                                                                                                                                                                                                                                                                                            if (ownerAmount > 0) {
                                                                                                                                                                                                                                                                                                                            send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                to: self.owner,
                                                                                                                                                                                                                                                                                                                                                                    value: ownerAmount,
                                                                                                                                                                                                                                                                                                                                                                                        mode: 64
                                                                                                                                                                                                                                                                                                                                                                                                        });
                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                            // ارسال Jetton به فرستنده
                                                                                                                                                                                                                                                                                                                                                                                                                                                        send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        to: self.jettonWallet,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        value: ton("0.1"), // هزینه گس
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        body: beginCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeUint(0xf8a7ea5, 32) // op-code: transfer jettons
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeUint(0, 64) // query_id
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeCoins(ton("1")) // مقدار Jetton (1 واحد)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeAddress(sender) // آدرس دریافت‌کننده
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeAddress(self.owner) // آدرس پاسخ‌دهنده
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeUint(0, 1) // custom payload
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeCoins(ton("0.01")) // مقدار TON برای ارسال به گیرنده
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeUint(0, 1) // forward payload
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .endCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                } 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            // تابع برای تغییر قیمت (فقط مالک)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                fun changePrice(newPrice: Int) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        require(context().sender == self.owner, "Only owner can change price");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                self.price = newPrice;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }