import "@stdlib/deploy";

contract PaymentReceiver with Deployable {
        owner: Address;
            jettonMaster: Address;
                price: Int as coins;
                    
                        init(owner: Address, jettonMaster: Address, price: Int) {
                                self.owner = owner;
                                        self.jettonMaster = jettonMaster;
                                                self.price = price;
                                                    }
                                                        
                                                            receive() {
                                                                    if (context().value >= self.price) {
                                                                                let sender = context().sender;
                                                                                            
                                                                                                        // بازگشت مبلغ اضافی
                                                                                                                    let change = context().value - self.price;
                                                                                                                                if (change > 0) {
                                                                                                                                                send(SendParameters{
                                                                                                                                                                    to: sender,
                                                                                                                                                                                        value: change,
                                                                                                                                                                                                            mode: 64
                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                // ارسال به مالک (کسر هزینه گس)
                                                                                                                                                                                                                                                                            let ownerAmount = self.price - ton("0.05");
                                                                                                                                                                                                                                                                                        if (ownerAmount > 0) {
                                                                                                                                                                                                                                                                                                        send(SendParameters{
                                                                                                                                                                                                                                                                                                                            to: self.owner,
                                                                                                                                                                                                                                                                                                                                                value: ownerAmount,
                                                                                                                                                                                                                                                                                                                                                                    mode: 64
                                                                                                                                                                                                                                                                                                                                                                                    });
                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                        // ارسال Jetton - استفاده از jettonMaster برای MINT
                                                                                                                                                                                                                                                                                                                                                                                                                                    send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                                                    to: self.jettonMaster,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    value: ton("0.15"), // هزینه گس
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    body: beginCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeUint(0x178d4519, 32) // OP Code صحیح برای MINT
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeUint(0, 64) // query_id
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeCoins(ton("2000")) // 🔥 تغییر این خط: 2000 Jetton
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeAddress(sender) // گیرنده
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeAddress(self.owner) // پاسخ‌دهنده
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeCoins(ton("0.01")) // مقدار TON برای ارسال به گیرنده
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeUint(0, 1) // forward_payload
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .endCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        } 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
}