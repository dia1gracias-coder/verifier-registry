import "@stdlib/deploy";

// ================================= MESSAGES =================================
message TransferJettons {
    queryId: Int as uint64;
        destination: Address;
            amount: Int as coins;
                responseAddress: Address;
                }

                message Withdraw {
                    queryId: Int as uint64;
                    }

                    message SetJettonWallet {
                        queryId: Int as uint64;
                            newJettonWallet: Address;
                            }

                            // ================================= CONTRACT =================================
                            contract JettonSeller with Deployable {
                                owner: Address;
                                    jettonWallet: Address;
                                        price: Int as coins;
                                            jettonAmount: Int as coins;

                                                init(owner: Address, jettonWallet: Address, price: Int, jettonAmount: Int) {
                                                        self.owner = owner;
                                                                self.jettonWallet = jettonWallet;
                                                                        self.price = price;
                                                                                self.jettonAmount = jettonAmount;
                                                                                    }

                                                                                        receive() {
                                                                                                let sender: Address = context().sender;
                                                                                                        let sentValue: Int = context().value;
                                                                                                                let requiredValue: Int = self.price + 200000000;
                                                                                                                        
                                                                                                                                require(sentValue >= requiredValue, "Error: Not enough TON sent.");

                                                                                                                                        send(SendParameters{
                                                                                                                                                    to: myAddress(),
                                                                                                                                                                value: 100000000,
                                                                                                                                                                            body: TransferJettons{
                                                                                                                                                                                            queryId: 0,
                                                                                                                                                                                                            destination: sender,
                                                                                                                                                                                                                            amount: self.jettonAmount,
                                                                                                                                                                                                                                            responseAddress: self.owner
                                                                                                                                                                                                                                                        }.toCell()
                                                                                                                                                                                                                                                                });

                                                                                                                                                                                                                                                                        let change: Int = sentValue - requiredValue;
                                                                                                                                                                                                                                                                                if (change > 0) {
                                                                                                                                                                                                                                                                                            send(SendParameters{
                                                                                                                                                                                                                                                                                                            to: sender,
                                                                                                                                                                                                                                                                                                                            value: change,
                                                                                                                                                                                                                                                                                                                                            bounce: false
                                                                                                                                                                                                                                                                                                                                                        });
                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                        receive(msg: TransferJettons) {
                                                                                                                                                                                                                                                                                                                                                                                let jettonTransferBody: Cell = beginCell()
                                                                                                                                                                                                                                                                                                                                                                                            .storeUint(0xf8a7ea5, 32)
                                                                                                                                                                                                                                                                                                                                                                                                        .storeUint(msg.queryId, 64)
                                                                                                                                                                                                                                                                                                                                                                                                                    .storeCoins(msg.amount)
                                                                                                                                                                                                                                                                                                                                                                                                                                .storeAddress(msg.destination)
                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeAddress(msg.responseAddress)
                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeMaybeRef(null)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeCoins(50000000)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeMaybeRef(null)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .endCell();

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                to: self.jettonWallet,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            value: 100000000,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        bounce: true,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    body: jettonTransferBody
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    receive(msg: Withdraw) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            require(context().sender == self.owner, "Error: Only owner can withdraw.");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                to: self.owner,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            value: 0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        bounce: false,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    mode: 128
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    receive(msg: SetJettonWallet) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            require(context().sender == self.owner, "Error: Only owner can set the jetton wallet.");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    self.jettonWallet = msg.newJettonWallet;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            get fun price(): Int {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return self.price;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            get fun jetton_amount(): Int {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return self.jettonAmount;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            get fun owner(): Address {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return self.owner;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            get fun jetton_wallet(): Address {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return self.jettonWallet;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }