import "@stdlib/deploy";

contract PaymentReceiver with Deployable {
    owner: Address;
        jettonMaster: Address;
            
                init(owner: Address, jettonMaster: Address) {
                        self.owner = owner;
                                self.jettonMaster = jettonMaster;
                                    }
                                        
                                            receive() {
                                                    // فقط پرداخت‌های بالای 0.1 TON را پردازش می‌کند تا هزینه گس پوشش داده شود
                                                            if (context().value > ton("0.1")) {
                                                                        let sender = context().sender;
                                                                                    
                                                                                                // ارسال TON به مالک سیستم با کسر هزینه گس
                                                                                                            let amountToSend = context().value - ton("0.05");
                                                                                                                        if (amountToSend > 0) {
                                                                                                                                        send(SendParameters{
                                                                                                                                                            to: self.owner,
                                                                                                                                                                                value: amountToSend,
                                                                                                                                                                                                    mode: 64 // پرداخت هزینه گس از طرف فرستنده
                                                                                                                                                                                                                    });
                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                        // محاسبه مقدار Jetton برای ارسال (1 TON = 1000 Jetton)
                                                                                                                                                                                                                                                                    // این نرخ تبدیل را می‌توانید بر اساس نیاز خود تغییر دهید
                                                                                                                                                                                                                                                                                let jettonAmount = context().value * 1000;
                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                        // درخواست ارسال Jetton از قرارداد JettonMaster
                                                                                                                                                                                                                                                                                                                    send(SendParameters{
                                                                                                                                                                                                                                                                                                                                    to: self.jettonMaster,
                                                                                                                                                                                                                                                                                                                                                    value: ton("0.1"), // ارزش برای پوشش هزینه گس
                                                                                                                                                                                                                                                                                                                                                                    body: beginCell()
                                                                                                                                                                                                                                                                                                                                                                                        .storeUint(0, 32) // op کد برای فراخوانی توابع عمومی
                                                                                                                                                                                                                                                                                                                                                                                                            .storeUint(0, 64) // query_id
                                                                                                                                                                                                                                                                                                                                                                                                                                .storeCoins(jettonAmount)
                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeAddress(sender)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .endCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }