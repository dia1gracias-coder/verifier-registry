#include "imports/stdlib.fc";

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    ;; Parse the incoming message to get the sender
    slice cs = in_msg_full.begin_parse();
    cs~skip_bits(4);                    ;; skip flags
    slice sender = cs~load_msg_addr();

    ;; Build a simple comment message
    cell msg = begin_cell()
        .store_uint(0x10, 6)            ;; non-bounceable simple message
        .store_slice(sender)
        .store_coins(0)                 ;; 0 TON
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)  ;; empty headers
        .store_uint(0, 32)              ;; op = 0 → text comment
        .store_slice("Hello buddy!")
        .end_cell();

    send_raw_message(msg, 64);          ;; mode 64 = carry remaining value
}
