import "@stdlib/deploy";

// پیام برای برداشت موجودی توسط مالک
message Withdraw {
    queryId: Int as uint64;
    }

    // پیام برای تنظیم آدرس کیف پول جتتون توسط مالک
    message SetJettonWallet {
        jettonWallet: Address;
        }

        // پیام اصلی برای پردازش پرداخت از سمت مینی‌اپ
        message ProcessPayment {
            tagId: String;          // تگ برای کامنت
                jettonAmount: Int as uint32; // مقدار جتتون برای ارسال به کاربر (واحد کامل)
                    tonAmount: Int as uint32;    // مقدار تون که کاربر باید بپردازد (واحد کامل)
                    }

                    contract Cashback with Deployable {
                        owner: Address;
                            jettonWallet: Address?;

                                init(owner: Address) {
                                        self.owner = owner;
                                                self.jettonWallet = null;
                                                    }

                                                        // Receive خالی برای دیپلوی و دریافت TON ساده
                                                            receive() {
                                                                    // این تابع اجازه می‌دهد قرارداد به سادگی TON دریافت کند (مثلاً برای شارژ اولیه)
                                                                        }

                                                                            // دریافت پیام از مینی‌اپ برای پردازش پرداخت
                                                                                receive(msg: ProcessPayment) {
                                                                                        let sender: Address = context().sender;
                                                                                                
                                                                                                        // بررسی حیاتی ۱: آیا کیف پول جتتون توسط مالک تنظیم شده است؟
                                                                                                                require(self.jettonWallet != null, "Error: Jetton wallet address is not set by the owner.");
                                                                                                                        
                                                                                                                                // <<<< اصلاح کلیدی و امنیتی در اینجا اضافه شده است >>>>
                                                                                                                                        // بررسی حیاتی ۲: آیا مقدار TON ارسال شده با تراکنش، با مقدار مورد انتظار در پیام برابر است؟
                                                                                                                                                // مقدار msg.tonAmount به واحد کامل TON است، آن را به نانوتون تبدیل می‌کنیم.
                                                                                                                                                        let requiredNanoTonAmount: Int = msg.tonAmount * 1_000_000_000;
                                                                                                                                                                require(context().value >= requiredNanoTonAmount, "Error: Incorrect TON amount sent with the transaction.");

                                                                                                                                                                        // ساخت پیام کامنت برای انتقال جتتون
                                                                                                                                                                                // این کامنت در کیف پول گیرنده نمایش داده خواهد شد
                                                                                                                                                                                        let commentText: String = beginString()
                                                                                                                                                                                                    .concat("from me - ") // پیشوند ثابت
                                                                                                                                                                                                                .concat(msg.tagId)     // تگ دریافتی از مینی‌اپ
                                                                                                                                                                                                                            .toString();
                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                let customMessage: Cell = beginCell()
                                                                                                                                                                                                                                                            .storeUint(0, 32) // پیشوند برای پیام متنی (0x00000000)
                                                                                                                                                                                                                                                                        .storeSlice(commentText.asSlice())
                                                                                                                                                                                                                                                                                    .endCell();

                                                                                                                                                                                                                                                                                            // محاسبه مقدار جتتون (در واحد نانو جتتون)
                                                                                                                                                                                                                                                                                                    // فرض: مقدار ورودی jettonAmount بر اساس واحد کامل جتتون با 6 رقم اعشار است (مثل USDT)
                                                                                                                                                                                                                                                                                                            let jettonAmountNano: Int = msg.jettonAmount * 1_000_000;

                                                                                                                                                                                                                                                                                                                    // ساخت بدنه اصلی پیام انتقال جتتون (Jetton Transfer)
                                                                                                                                                                                                                                                                                                                            let transferBody: Cell = beginCell()
                                                                                                                                                                                                                                                                                                                                        .storeUint(0xf8a7ea5, 32)      // op-code برای انتقال جتتون (transfer)
                                                                                                                                                                                                                                                                                                                                                    .storeUint(0, 64)              // query_id (می‌تواند صفر باشد)
                                                                                                                                                                                                                                                                                                                                                                .storeCoins(jettonAmountNano)  // مقدار جتتون برای انتقال
                                                                                                                                                                                                                                                                                                                                                                            .storeAddress(sender)          // آدرس گیرنده (کاربری که تراکنش را ارسال کرده)
                                                                                                                                                                                                                                                                                                                                                                                        .storeAddress(self.owner)      // آدرس پاسخ (در صورت بروز خطا، جتتون‌ها به مالک برمی‌گردند)
                                                                                                                                                                                                                                                                                                                                                                                                    .storeUint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1) // custom_payload (خالی)
                                                                                                                                                                                                                                                                                                                                                                                                                .storeCoins(1)                 // مقدار TON برای فوروارد پیام (مقدار ناچیز برای ثبت کامنت)
                                                                                                                                                                                                                                                                                                                                                                                                                            .storeUint(1, 1)               // forward_payload به عنوان یک سلول ارجاعی (ref)
                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeRef(customMessage)       // ارجاع به سلول حاوی کامنت
                                                                                                                                                                                                                                                                                                                                                                                                                                                    .endCell();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        // ارسال پیام به کیف پول جتتون قرارداد برای اجرای انتقال
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            to: self.jettonWallet!!, // آدرس کیف پول جتتون (با !! اطمینان حاصل می‌کنیم که null نیست)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        value: 50_000_000,       // 0.05 TON برای پوشش کارمزدهای داخلی پیام‌رسانی
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    bounce: true,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                mode: SendIgnoreErrors,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            body: transferBody
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            // تابعی برای مالک قرارداد جهت تنظیم آدرس کیف پول جتتون
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                receive(msg: SetJettonWallet) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        require(context().sender == self.owner, "Error: Only the owner can set the jetton wallet.");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                require(self.jettonWallet == null, "Error: Jetton wallet can only be set once.");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        self.jettonWallet = msg.jettonWallet;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                // تابعی برای مالک قرارداد جهت برداشت TON‌های باقی‌مانده
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    receive(msg: Withdraw) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            require(context().sender == self.owner, "Error: Only the owner can withdraw funds.");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                to: self.owner,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            value: 0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        bounce: false,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    mode: SendRemainingBalance + SendIgnoreErrors
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    // --- Getter Functions ---

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        get fun getOwner(): Address {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                return self.owner;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        get fun getJettonWallet(): Address? {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                return self.jettonWallet;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        get fun isJettonWalletSet(): Bool {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                return self.jettonWallet != null;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        get fun balance(): Int {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                return myBalance();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }