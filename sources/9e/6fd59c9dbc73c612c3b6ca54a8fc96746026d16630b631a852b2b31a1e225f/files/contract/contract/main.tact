import "@stdlib/deploy";

contract PaymentReceiver with Deployable {
        owner: Address;
            jettonWallet: Address; // آدرس Jetton Wallet شما
                price: Int as coins;
                    
                        init(owner: Address, jettonWallet: Address, price: Int) {
                                self.owner = owner;
                                        self.jettonWallet = jettonWallet;
                                                self.price = price;
                                                    }
                                                        
                                                            receive() {
                                                                    if (context().value >= self.price) {
                                                                                let sender = context().sender;
                                                                                            
                                                                                                        // بازگشت مبلغ اضافی
                                                                                                                    let change = context().value - self.price;
                                                                                                                                if (change > 0) {
                                                                                                                                                send(SendParameters{
                                                                                                                                                                    to: sender,
                                                                                                                                                                                        value: change,
                                                                                                                                                                                                            mode: 64
                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                // ارسال TON به مالک
                                                                                                                                                                                                                                                                            send(SendParameters{
                                                                                                                                                                                                                                                                                            to: self.owner,
                                                                                                                                                                                                                                                                                                            value: self.price - ton("0.05"),
                                                                                                                                                                                                                                                                                                                            mode: 64
                                                                                                                                                                                                                                                                                                                                        });
                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                // 🔥 ارسال مستقیم Jetton از کیف پول شما
                                                                                                                                                                                                                                                                                                                                                                            send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                            to: self.jettonWallet, // از کیف پول Jetton شما
                                                                                                                                                                                                                                                                                                                                                                                                            value: ton("0.1"), // هزینه گس
                                                                                                                                                                                                                                                                                                                                                                                                                            body: beginCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeUint(0xf8a7ea5, 32) // OP Code انتقال Jetton
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeUint(0, 64) // query_id
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeCoins(ton("2000")) // مقدار Jetton
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeAddress(sender) // گیرنده
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeAddress(self.owner) // پاسخ‌دهنده
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeCoins(ton("0.02")) // TON برای گیرنده
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeUint(0, 1) // forward_payload
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .endCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                } 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
}