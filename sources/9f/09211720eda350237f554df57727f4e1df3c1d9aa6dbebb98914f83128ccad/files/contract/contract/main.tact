import "@stdlib/deploy";

contract JettonSeller {
        owner: Address;
            jettonWallet: Address;
                price: Int as coins;
                    jettonAmount: Int as coins;

                        init(owner: Address, jettonWallet: Address, price: Int, jettonAmount: Int) {
                                self.owner = owner;
                                        self.jettonWallet = jettonWallet;
                                                self.price = price;
                                                        self.jettonAmount = jettonAmount;
                                                            }

                                                                receive() {
                                                                        let sender = context().sender;
                                                                                let value = context().value;

                                                                                        if (value >= self.price) {
                                                                                                    let change = value - self.price;
                                                                                                                if (change > 0) {
                                                                                                                                send(SendParameters{
                                                                                                                                                    to: sender,
                                                                                                                                                                        value: change,
                                                                                                                                                                                            bounce: false,
                                                                                                                                                                                                                mode: 64
                                                                                                                                                                                                                                });
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                        send(SendParameters{
                                                                                                                                                                                                                                                                        to: self.owner,
                                                                                                                                                                                                                                                                                        value: self.price - 30000000000,
                                                                                                                                                                                                                                                                                                        bounce: false,
                                                                                                                                                                                                                                                                                                                        mode: 64
                                                                                                                                                                                                                                                                                                                                    });

                                                                                                                                                                                                                                                                                                                                                send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                to: self.jettonWallet,
                                                                                                                                                                                                                                                                                                                                                                                value: 50000000000,
                                                                                                                                                                                                                                                                                                                                                                                                bounce: true,
                                                                                                                                                                                                                                                                                                                                                                                                                mode: 64,
                                                                                                                                                                                                                                                                                                                                                                                                                                body: beginCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeUint(0xf8a7ea5, 32)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeUint(0, 64)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeCoins(self.jettonAmount)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeAddress(sender)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeAddress(sender)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeCoins(10000000000)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeUint(1, 1)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeRef(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        beginCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeUint(0x5265636569766520, 64) // "Receive "
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeInt(self.jettonAmount, 64)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeUint(0x2058595a20546f6b656e, 64) // " XYZ Token"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .endCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .endCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
