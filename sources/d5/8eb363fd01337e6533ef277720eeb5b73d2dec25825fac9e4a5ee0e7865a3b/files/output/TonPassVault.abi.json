    {
      "kind": "struct",
      "name": "AdminKeys",
      "ty_idx": 36,
      "fields": [
        {
          "name": "owner",
          "ty_idx": 7
        },
        {
          "name": "guardian",
          "ty_idx": 7
        },
        {
          "name": "signerKey",
          "ty_idx": 20
        }
      ],
      "description": "owner is the cold multisig. It also doubles as the funding address: USDT\narriving from `owner` is treated as topping up the payout float, anything\nelse is a voucher purchase."
    },
    {
      "kind": "struct",
      "name": "Routing",
      "ty_idx": 38,
      "fields": [
        {
          "name": "gasWallet",
          "ty_idx": 7
        },
        {
          "name": "excessTo",
          "ty_idx": 7
        },
        {
          "name": "jettonWallet",
          "ty_idx": 39
        }
      ],
      "description": "gasWallet is the only sender allowed to submit a batch. excessTo receives\nTEP-74 excesses from payouts — pointing it at the gas wallet returns leftover\nTON to the account that paid it and keeps N receipts off this contract."
    },
    {
      "kind": "struct",
      "name": "VoucherRoutes",
      "ty_idx": 41,
      "fields": [
        {
          "name": "revenueWallet",
          "ty_idx": 7
        },
        {
          "name": "coldWallet",
          "ty_idx": 7
        }
      ],
      "description": "Where a voucher payment is split to. Both are fixed by the owner and never\nread from the incoming payload, so a buyer can never redirect their payment."
    },
    {
      "kind": "struct",
      "name": "Limits",
      "ty_idx": 43,
      "fields": [
        {
          "name": "paused",
          "ty_idx": 5
        },
        {
          "name": "maxBatch",
          "ty_idx": 14
        },
        {
          "name": "tonPerPayout",
          "ty_idx": 6
        },
        {
          "name": "batchOverhead",
          "ty_idx": 6
        },
        {
          "name": "maxPerPayout",
          "ty_idx": 6
        },
        {
          "name": "dailyCap",
          "ty_idx": 6
        },
        {
          "name": "daySpent",
          "ty_idx": 6
        },
        {
          "name": "windowStartedAt",
          "ty_idx": 9
        },
        {
          "name": "lastBatchId",
          "ty_idx": 11
        },
        {
          "name": "feeBps",
          "ty_idx": 14,
          "description": "Fee quoted ON TOP of the voucher face value: a 100 voucher at 3% is paid\nas 103, so the fee is feeBps/(10000+feeBps) of what arrives — NOT\nfeeBps/10000, which would take 3.09 out of 103 and short the cold wallet."
        },
        {
          "name": "minPaymentGas",
          "ty_idx": 6,
          "description": "Floor on the `forward_ton_amount` a buyer must attach. It funds the\ncompute phase AND both outgoing legs, so it is around 0.1 TON — too low\nand the action phase fails and the payment strands."
        }
      ],
      "description": "maxBatch / tonPerPayout / batchOverhead are settable because the real numbers\ncan only come from measuring gas on a live network.\n\nThe daily cap is a tumbling 24h window, not a true sliding one: a sliding\nwindow needs a ring buffer of timestamps and its cost grows per batch. The\ntradeoff is that up to 2x dailyCap can leave across a window boundary.\n\n`paused` stops payouts AND voucher payments. A payment that arrives while\npaused strands in this contract, because a jetton transfer cannot be refused;\n`WithdrawJettons` is how it is refunded."
    },
