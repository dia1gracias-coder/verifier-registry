import "@stdlib/deploy";

message Purchase {
    queryId: Int as uint64;
        jettonAmount: Int as coins;
            tagId: Slice;
                expectedTonAmount: Int as coins;
                }

                message Withdraw {
                    queryId: Int as uint64;
                    }

                    message SetJettonWallet {
                        jettonWallet: Address;
                        }

                        // فقط کافیست "with Deployable" را داشته باشیم.
                        // این trait به صورت خودکار پیام و تابع receive مربوط به Deploy را مدیریت می‌کند.
                        contract Cashback with Deployable {
                            owner: Address;
                                jettonWallet: Address?;

                                    init(owner: Address) {
                                            self.owner = owner;
                                                    self.jettonWallet = null;
                                                        }
                                                            
                                                                // این بخش به طور کامل حذف شد چون Deployable trait آن را فراهم می‌کند
                                                                    // receive(msg: Deploy) {
                                                                        //     deploy(msg);
                                                                            // }

                                                                                receive(msg: Purchase) {
                                                                                        let incomingTon: Int = context().value;
                                                                                                let sender: Address = context().sender;

                                                                                                        require(incomingTon >= msg.expectedTonAmount, "Incorrect TON amount sent");
                                                                                                                require(self.jettonWallet != null, "Jetton wallet not set");

                                                                                                                        let customComment: Cell = beginCell()
                                                                                                                                    .storeUint(0, 32)
                                                                                                                                                .storeSlice("from me ".asSlice())
                                                                                                                                                            .storeSlice(msg.tagId)
                                                                                                                                                                        .endCell();

                                                                                                                                                                                let transferBody: Cell = beginCell()
                                                                                                                                                                                            .storeUint(0xf8a7ea5, 32)
                                                                                                                                                                                                        .storeUint(msg.queryId, 64)
                                                                                                                                                                                                                    .storeCoins(msg.jettonAmount)
                                                                                                                                                                                                                                .storeAddress(sender)
                                                                                                                                                                                                                                            .storeAddress(self.owner)
                                                                                                                                                                                                                                                        .storeUint(0, 1)
                                                                                                                                                                                                                                                                    .storeCoins(1)
                                                                                                                                                                                                                                                                                .storeUint(1, 1)
                                                                                                                                                                                                                                                                                            .storeRef(customComment)
                                                                                                                                                                                                                                                                                                        .endCell();

                                                                                                                                                                                                                                                                                                                send(SendParameters{
                                                                                                                                                                                                                                                                                                                            to: self.jettonWallet!!,
                                                                                                                                                                                                                                                                                                                                        value: 0,
                                                                                                                                                                                                                                                                                                                                                    bounce: true,
                                                                                                                                                                                                                                                                                                                                                                mode: SendRemainingValue,
                                                                                                                                                                                                                                                                                                                                                                            body: transferBody
                                                                                                                                                                                                                                                                                                                                                                                    });
                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                            receive(msg: SetJettonWallet) {
                                                                                                                                                                                                                                                                                                                                                                                                    require(context().sender == self.owner, "Not authorized: only owner can set jetton wallet");
                                                                                                                                                                                                                                                                                                                                                                                                            self.jettonWallet = msg.jettonWallet;
                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                    receive(msg: Withdraw) {
                                                                                                                                                                                                                                                                                                                                                                                                                            require(context().sender == self.owner, "Not authorized: only owner can withdraw");

                                                                                                                                                                                                                                                                                                                                                                                                                                    send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                                                                                to: self.owner,
                                                                                                                                                                                                                                                                                                                                                                                                                                                            value: 0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        bounce: false,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    mode: SendRemainingValue + SendIgnoreErrors
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    get fun getOwner(): Address {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return self.owner;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    get fun getJettonWallet(): Address? {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return self.jettonWallet;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    get fun isJettonWalletSet(): Bool {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            return self.jettonWallet != null;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }