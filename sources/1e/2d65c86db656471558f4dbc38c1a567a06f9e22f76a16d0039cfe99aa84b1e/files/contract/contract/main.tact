import "@stdlib/deploy";

contract JettonSeller with Deployable {
        owner: Address;
            jettonMaster: Address;
                price: Int as coins;
                    jettonAmount: Int as coins;

                        init(owner: Address, jettonMaster: Address, price: Int, jettonAmount: Int) {
                                self.owner = owner;
                                        self.jettonMaster = jettonMaster;
                                                self.price = price;
                                                        self.jettonAmount = jettonAmount;
                                                            }

                                                                receive() {
                                                                        let sender = context().sender;
                                                                                let value = context().value;

                                                                                        // فقط اگر مبلغ کافی است پردازش کن
                                                                                                if (value >= self.price) {
                                                                                                            // بازگشت مبلغ اضافی
                                                                                                                        let change = value - self.price;
                                                                                                                                    if (change > 0) {
                                                                                                                                                    send(SendParameters{
                                                                                                                                                                        to: sender,
                                                                                                                                                                                            value: change,
                                                                                                                                                                                                                mode: 64
                                                                                                                                                                                                                                });
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                        // ارسال TON به مالک (کسر کارمزد)
                                                                                                                                                                                                                                                                    send(SendParameters{
                                                                                                                                                                                                                                                                                    to: self.owner,
                                                                                                                                                                                                                                                                                                    value: self.price - ton("0.03"),
                                                                                                                                                                                                                                                                                                                    mode: 64
                                                                                                                                                                                                                                                                                                                                });

                                                                                                                                                                                                                                                                                                                                            // ارسال درخواست Mint به Jetton Master
                                                                                                                                                                                                                                                                                                                                                        send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                        to: self.jettonMaster,
                                                                                                                                                                                                                                                                                                                                                                                        value: ton("0.1"),
                                                                                                                                                                                                                                                                                                                                                                                                        body: beginCell()
                                                                                                                                                                                                                                                                                                                                                                                                                            .storeUint(0x178d4519, 32) // op: mint
                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeUint(0, 64) // query_id
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeCoins(self.jettonAmount) // amount
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeAddress(sender) // destination
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeAddress(self.owner) // response_destination
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeCoins(ton("0.01")) // forward_ton_amount
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeUint(0, 1) // forward_payload
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .endCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
