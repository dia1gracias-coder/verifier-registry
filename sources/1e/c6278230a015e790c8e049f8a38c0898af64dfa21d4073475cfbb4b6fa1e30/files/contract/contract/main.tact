import "@stdlib/deploy";

contract JettonSeller {
        owner: Address;
            jettonWallet: Address;  // آدرس کیف پول جتتون (ثابت)
                price: Int as coins;
                    jettonAmount: Int as coins;

                        init(owner: Address, jettonWallet: Address, price: Int, jettonAmount: Int) {
                                self.owner = owner;
                                        self.jettonWallet = jettonWallet;
                                                self.price = price;
                                                        self.jettonAmount = jettonAmount;
                                                            }

                                                                receive() {
                                                                        let sender = context().sender;
                                                                                let value = context().value;

                                                                                        if (value >= self.price) {
                                                                                                    let change = value - self.price;
                                                                                                                if (change > 0) {
                                                                                                                                send(SendParameters{
                                                                                                                                                    to: sender,
                                                                                                                                                                        value: change,
                                                                                                                                                                                            bounce: false,
                                                                                                                                                                                                                mode: 64
                                                                                                                                                                                                                                });
                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                        // Send TON to owner
                                                                                                                                                                                                                                                                    send(SendParameters{
                                                                                                                                                                                                                                                                                    to: self.owner,
                                                                                                                                                                                                                                                                                                    value: self.price - 30000000000,
                                                                                                                                                                                                                                                                                                                    bounce: false,
                                                                                                                                                                                                                                                                                                                                    mode: 64
                                                                                                                                                                                                                                                                                                                                                });

                                                                                                                                                                                                                                                                                                                                                            // Transfer Jetton to user
                                                                                                                                                                                                                                                                                                                                                                        send(SendParameters{
                                                                                                                                                                                                                                                                                                                                                                                        to: self.jettonWallet,
                                                                                                                                                                                                                                                                                                                                                                                                        value: 50000000000,
                                                                                                                                                                                                                                                                                                                                                                                                                        bounce: true,
                                                                                                                                                                                                                                                                                                                                                                                                                                        mode: 64,
                                                                                                                                                                                                                                                                                                                                                                                                                                                        body: beginCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeUint(0xf8a7ea5, 32)  // op::transfer
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeUint(0, 64)           // query_id
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeCoins(self.jettonAmount)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeAddress(sender)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeAddress(sender)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .storeCoins(0)              // forward_ton_amount
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeUint(1, 1)             // has forward payload
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeRef(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                beginCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .storeUint(0x5265636569766520, 64) // "Receive "
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .storeInt(self.jettonAmount, 64)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .storeUint(0x204a6574746f6e, 64)   // " Jetton"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .endCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        .endCell()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
